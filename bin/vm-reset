#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$(realpath "$0")")/common.sh"

echo "Deleting machine '$MACHINE_NAME'..."
smolvm machine delete --name "$MACHINE_NAME" -f 2>/dev/null || true
rm -f "/tmp/smolvm-${MACHINE_NAME}.mount"

if [[ -f "$PACK_SIDECAR" ]]; then
  echo "Recreating '$MACHINE_NAME' from the existing pack (same image, clean state)..."
  ALLOW_HOST_ARGS=()
  for h in "${ALLOWED_HOSTS[@]}"; do
    ALLOW_HOST_ARGS+=(--allow-host "$h")
  done
  SSH_AGENT_ARGS=()
  if [[ -n "${SSH_AUTH_SOCK:-}" ]]; then
    SSH_AGENT_ARGS+=(--ssh-agent)
  fi
  smolvm machine create --name "$MACHINE_NAME" --from "$PACK_SIDECAR" \
    --cpus "$VM_CPUS" --mem "$VM_MEM" --net \
    "${ALLOW_HOST_ARGS[@]}" "${SSH_AGENT_ARGS[@]}"
  echo "Done."
else
  echo "No pack found at $PACK_SIDECAR -- run ./setup to build one."
fi
