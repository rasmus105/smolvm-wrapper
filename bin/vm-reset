#!/usr/bin/env bash
# Wipes the machine assigned to the CURRENT directory and claims a fresh one
# (from the spare pool if one's ready, otherwise creates one -- same as any
# other vm-* invocation). Does not touch other directories' machines or
# rebuild the image; that's ./setup's job.
set -euo pipefail
source "$(dirname "$(realpath "$0")")/common.sh"

dir="$(pwd -P)"
hash="$(_pwd_hash "$dir")"
machine="$(_assigned_machine_for_hash "$hash")"

if [[ -n "$machine" ]]; then
  echo "Deleting machine '$machine' (was assigned to this directory)..."
  smolvm machine delete --name "$machine" -f 2>/dev/null || true
  _with_pool_lock _remove_assignment "$hash"
else
  echo "No machine was assigned to this directory yet."
fi

echo "Claiming a fresh machine for this directory..."
machine="$(resolve_machine_for_cwd)"
echo "Done. '$machine' is ready for $dir."
